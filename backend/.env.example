# LegalVault Backend Environment Configuration

# Environment mode: development | staging | production
LEGALVAULT_ENV=development

# Blockchain RPC endpoint (Default: local Hardhat node)
LEGALVAULT_RPC_URL=http://127.0.0.1:8545

# Deployed LegalVault smart contract address on EVM
LEGALVAULT_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Optional private key for signing transactions (leave empty for node account #0)
# LEGALVAULT_PRIVATE_KEY=

# Maximum upload file size in megabytes (Default: 10 MB)
LEGALVAULT_UPLOAD_MAX_MB=10

# Comma-separated list of allowed document file extensions
LEGALVAULT_ALLOWED_EXTENSIONS=.pdf,.txt,.docx,.jpg,.jpeg,.png

# JWT Secret key for signing authentication tokens (set a secure random string in production)
LEGALVAULT_JWT_SECRET=legalvault-secure-mvp-jwt-secret-key-2026
